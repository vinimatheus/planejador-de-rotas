PORT=3333
HOST=0.0.0.0
# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000
# Servidor OSRM (o público é só para testes; use o seu em produção)
OSRM_URL=https://router.project-osrm.org
# Nominatim exige um User-Agent identificável com contato
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=router-map/1.0 (contato@example.com)
